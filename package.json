{
  "name": "job-finish",
  "version": "0.1.4",
  "description": "Windows toast notifications for Claude Code & Codex with taskbar flashing and VS Code focus on click.",
  "type": "module",
  "bin": {
    "job-finish": "dist/index.js"
  },
  "files": [
    "dist",
    "templates/notify.win.ps1",
    "templates/jf-focus-vscode.exe"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-focus-exe.mjs",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsc892/Job-Finish.git"
  },
  "homepage": "https://github.com/lsc892/Job-Finish#readme",
  "bugs": {
    "url": "https://github.com/lsc892/Job-Finish/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "hooks",
    "notification",
    "toast",
    "cli",
    "vscode",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@iarna/toml": "^2.2.5",
    "picocolors": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0"
  },
  "os": [
    "win32"
  ]
}
