{
  "name": "JobFinish",
  "private": true,
  "displayName": "Job-Finish",
  "icon": "resources/icon/JobFinish_Icon.png",
  "description": "Window-scoped Codex and Claude execution notifications for Windows.",
  "version": "2.3.0",
  "publisher": "JobFinish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsc892/Job-Finish.git"
  },
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node build/extension.mjs",
    "install:extension": "npm --prefix tools/installer run install:extension --",
    "update:extension": "npm --prefix tools/installer run update:extension --",
    "uninstall:legacy": "npm --prefix tools/installer run uninstall:legacy --",
    "build:installer": "npm --prefix tools/installer run build -- --vsix ../../job-finish-win32-x64.vsix",
    "package:npm": "npm run build:installer && npm pack ./tools/installer",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:load": "tsx --expose-gc tests/load/load.ts",
    "test:router-load": "tsx --expose-gc tests/load/router-load.ts",
    "test:extension": "npm run build && node tests/vscode/extension-host.mjs",
    "test:windows": "npm run build && node tests/vscode/extension-host.mjs --dual",
    "test:package": "node tests/package/verify-package.mjs",
    "test:toast": "tsx tests/windows/native-toast.ts",
    "test:native": "node tests/windows/native-toast-contract.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --target win32-x64 --out job-finish-win32-x64.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "jobFinish.results",
        "title": "Job-Finish: Show Results"
      },
      {
        "command": "jobFinish.bindWindow",
        "title": "Job-Finish: Bind This Windows Window"
      },
      {
        "command": "jobFinish.stopFlash",
        "title": "Job-Finish: Stop Flash"
      },
      {
        "command": "jobFinish.diagnostics",
        "title": "Job-Finish: Show Diagnostics"
      }
    ],
    "configuration": [
      {
        "id": "jobFinish.general",
        "title": "General",
        "order": 1,
        "properties": {
          "jobFinish.enabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Automatically detect Codex and Claude activity in this VS Code window and show notifications. Changes apply immediately."
          }
        }
      },
      {
        "id": "jobFinish.notifications",
        "title": "Notifications",
        "order": 2,
        "properties": {
          "jobFinish.toast": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Show native Windows toasts while this window is unfocused."
          },
          "jobFinish.toastIcon": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Show an image beside the toast title and AI response. Defaults to the sleeping character; turn off for text-only toasts. Changes apply to the next toast."
          },
          "jobFinish.toastIconPath": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "order": 3,
            "description": "Optional local PNG, JPEG, GIF or BMP image for toasts. Empty uses the default sleeping character. Relative paths are resolved from the first workspace folder. Requires Toast Icon to be enabled."
          },
          "jobFinish.flash": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "description": "Flash a verified native window."
          },
          "jobFinish.flashMode": {
            "type": "string",
            "enum": [
              "manual",
              "system"
            ],
            "default": "manual",
            "order": 5
          },
          "jobFinish.flashTimeoutSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400,
            "default": 300,
            "order": 6,
            "description": "Flash expiry; 0 keeps flashing until focus, click or explicit stop."
          }
        }
      }
    ]
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
